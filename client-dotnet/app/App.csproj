<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PublishAot>true</PublishAot><TreatWarningsAsErrors>true</TreatWarningsAsErrors><RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <AssemblyName>wpilib-client</AssemblyName><InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <EmbeddedResource Include="$(ManagerAssets)/engine.zip" LogicalName="engine.zip" />
    <EmbeddedResource Include="$(ManagerAssets)/runtime.zip" LogicalName="runtime.zip" Condition="Exists('$(ManagerAssets)/runtime.zip')" />
    <EmbeddedResource Include="$(ManagerAssets)/bootstrap.json" LogicalName="bootstrap.json" />
  </ItemGroup>
</Project>
