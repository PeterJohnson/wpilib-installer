<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RuntimeFrameworkVersion>11.0.0</RuntimeFrameworkVersion>
        <AssemblyName>wpilib-client</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../core/Core.csproj" />
        <PackageReference Include="Avalonia.Wayland" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <EmbeddedResource Include="$(ManagerAssets)/engine.zip" LogicalName="engine.zip" />
        <EmbeddedResource
            Include="$(ManagerAssets)/runtime.zip"
            LogicalName="runtime.zip"
            Condition="Exists('$(ManagerAssets)/runtime.zip')"
        />
        <EmbeddedResource Include="$(ManagerAssets)/bootstrap.json" LogicalName="bootstrap.json" />
    </ItemGroup>
</Project>
